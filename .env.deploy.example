# Copier en .env.deploy (jamais commité : .env.* est ignoré) et renseigner.
FADI_DOMAIN=fadi.exemple.ch
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-long-et-unique
BACKUP_KEEP_DAYS=14

# D-7 : mot de passe du rôle applicatif fadi_app (l'API ne se connecte plus en administrateur de la base).
FADI_APP_DB_PASSWORD=remplacer-par-un-autre-mot-de-passe-long-et-unique
# FADI_RETENTION_DB_PASSWORD=

# Gestion des comptes — voir docs/workstreams/users-management/RUNBOOK.md.
FADI_ADMIN_ENABLED=false
# FADI_ENCRYPTION_KEY=   # openssl rand -base64 32
# MAIL_TRANSPORT=smtp
# SMTP_HOST=mail.infomaniak.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@exemple.ch
# SMTP_PASS=
# MAIL_FROM="Fadi <noreply@exemple.ch>"
# MAIL_DAILY_LIMIT=150
