#!/bin/bash
# Double de docker pour les tests de fadi-preprod : `compose config` est rendu par le vrai docker (sans démon) ; les
# autres verbes réussissent ou échouent selon MOCK_FAIL (liste de mots : build up run-check run-backup run-restore
# run-migrate image-rm e2e-<scénario>) ; MOCK_IMAGES liste les étiquettes rendues par `image ls`. MOCK_MIGRATE_LOG
# remplace la sortie du service migrate, MOCK_FADI_APP_CREATE le droit CREATE de fadi_app relu après migration, MOCK_TAR
# l'archive des rapports ; MOCK_TRACE reçoit chaque appel (avec les arguments de version de l'image).
orig=("$@")
[ -n "${MOCK_TRACE:-}" ] && echo "FADI_BUILD_COMMIT=${FADI_BUILD_COMMIT:-} FADI_BUILD_DATE=${FADI_BUILD_DATE:-} $*" >> "$MOCK_TRACE"
has() { [[ " ${MOCK_FAIL:-} " == *" $1 "* ]]; }
fail() { echo "double docker : échec simulé ($1)" >&2; exit 3; }
if [ "${1:-}" != compose ]; then
  case "${1:-}" in
    inspect) echo "${MOCK_HEALTH:-healthy}" ;;
    ps) echo "prod0001  app-db-1  Up 3 days" ;;
    image)
      case "${2:-}" in
        ls) for t in ${MOCK_IMAGES:-}; do echo "$t"; done ;;
        rm) has image-rm && fail "image rm" ;;
      esac ;;
  esac
  exit 0
fi
shift
while [ $# -gt 0 ]; do case "$1" in -p|-f|--project-directory|--env-file|--profile) shift 2 ;; -*) shift ;; *) break ;; esac; done
verb=${1:-}
cmdline="${orig[*]}"
case "$verb" in
  config) exec /usr/bin/docker "${orig[@]}" ;;
  build) has build && fail build; echo "build ok" ;;
  up|down|rm|stop) has "$verb" && fail "$verb"; echo "$verb ok" ;;
  ps) echo "cid0001" ;;
  logs) echo "journal" ;;
  exec) echo "tables publiques : 42 ; fadi_app peut créer : ${MOCK_FADI_APP_CREATE:-false}" ;;
  run)
    if [[ $cmdline == *"tar --null"* ]]; then
      if [ -n "${MOCK_TAR:-}" ]; then cat "$MOCK_TAR"; else tar -cf - -T /dev/null; fi; exit 0
    fi
    if [[ $cmdline =~ \ migrate$ ]]; then
      has run-migrate && { echo "Schema applied (init.sql)."; fail migrate; }
      printf '%s\n' "${MOCK_MIGRATE_LOG-Schema applied (init.sql).
D-7 : mot de passe appliqué pour fadi_app.
Migration terminée (MIGRATE_ONLY) : arrêt sans écouter.}"; exit 0
    fi
    [[ $cmdline == *"npm run typecheck"* ]] && has run-check && fail check
    [[ $cmdline == *"backup.sh"* ]] && has run-backup && fail backup
    [[ $cmdline == *"verify-restore"* ]] && has run-restore && fail restore
    [[ $cmdline =~ e2e/([a-z0-9-]+)\.mjs ]] && has "e2e-${BASH_REMATCH[1]}" && fail "e2e ${BASH_REMATCH[1]}"
    echo "recette ok" ;;
  *) echo "double docker : verbe inattendu $verb" >&2; exit 9 ;;
esac
exit 0
