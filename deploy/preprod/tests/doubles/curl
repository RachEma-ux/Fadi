#!/bin/bash
# Double de curl pour `fadi-preprod smoke` : réponses conformes, sauf écarts demandés par MOCK_* (voir run.sh).
o=/dev/null; d=/dev/null; url=
while [ $# -gt 0 ]; do case "$1" in -o) o=$2; shift 2 ;; -D) d=$2; shift 2 ;; -w|-H|-m) shift 2 ;; -*) shift ;; *) url=$1; shift ;; esac; done
[ -n "${MOCK_DOWN:-}" ] && { echo "curl: (7) Failed to connect" >&2; exit 7; }
path=/${url#http://*/}
code=404; body='Not Found'
case "$path" in
  /health) code=${MOCK_HEALTH_CODE:-200}; body=${MOCK_HEALTH_BODY:-'{"status":"ok","db":"ok"}'} ;;
  /projects) code=${MOCK_PROJECTS_CODE:-401}; body='{"error":"authentication_required"}' ;;
  /accueil) code=${MOCK_ACCUEIL_CODE:-200}; body=${MOCK_ACCUEIL_BODY:-'<!doctype html><div id="root"></div>'} ;;
esac
{ printf 'HTTP/1.1 %s X\r\n' "$code"
  [ -z "${MOCK_NO_NOSNIFF:-}" ] && printf 'X-Content-Type-Options: nosniff\r\n'
  printf 'X-Frame-Options: SAMEORIGIN\r\n'
  [ -n "${MOCK_POWERED:-}" ] && printf 'X-Powered-By: Express\r\n'
  printf '\r\n'; } > "$d"
printf '%s' "$body" > "$o"
printf '%s' "$code"
