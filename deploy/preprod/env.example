# Préproduction Fadi — clés attendues (valeurs générées par `fadi-preprod init-env`, jamais commitées, jamais celles de la production).
PREPROD_POSTGRES_PASSWORD=
PREPROD_ARCHIVE_SIGNING_KEY=
# Phase 3 (hôte seulement) : http://localhost:3001 — phase 4 (sur accord) : https://preprod.fadimmo.com
PREPROD_WEB_ORIGIN=http://localhost:3001
PREPROD_AUTH_RATE_LIMIT=500
PREPROD_API_RATE_LIMIT=5000
# Gestion des comptes (D-7) : mot de passe du rôle fadi_app (l'application ne se connecte jamais en superutilisateur) et
# clé de chiffrement des secrets de double authentification (32 octets en base64). Ajoutées par `fadi-preprod init-env`
# à un fichier existant, sans rien modifier d'autre.
PREPROD_FADI_APP_DB_PASSWORD=
PREPROD_FADI_ENCRYPTION_KEY=
# Administration de la plateforme (désactivée par défaut).
# PREPROD_FADI_ADMIN_ENABLED=false
# Courriel (D-1, UM-28), facultatif — ajouté à la main par l'administrateur, jamais par init-env. Sans
# PREPROD_MAIL_TRANSPORT : aucun envoi, liens à copier affichés. Avec smtp : SMTP Infomaniak, l'adresse de
# PREPROD_MAIL_FROM doit être PREPROD_SMTP_USER (sinon l'API refuse de démarrer). Les domaines réservés (example.com,
# *.test, *.invalid…) ne sont jamais envoyés. Mot de passe : celui de la boîte noreply, jamais dans le dépôt.
# PREPROD_MAIL_TRANSPORT=smtp
# PREPROD_SMTP_HOST=mail.infomaniak.com
# PREPROD_SMTP_PORT=465
# PREPROD_SMTP_SECURE=true
# PREPROD_SMTP_USER=noreply@fadimmo.com
# PREPROD_SMTP_PASS=
# PREPROD_MAIL_FROM="Fadi <noreply@fadimmo.com>"
# PREPROD_MAIL_DAILY_LIMIT=50
# PREPROD_MAIL_RECIPIENT_HOURLY_LIMIT=5
# Effacement automatique des contacts sans compte (organisations-participation, OP-5) : activé par défaut (1) ; 0 le coupe.
# PREPROD_CONTACT_RETENTION_ENABLED=1

# GeoData (D-GD-23, D-GD-29) : au démarrage de l'application, les fichiers de données livrés avec le code sont archivés
# en base, les fiches importées et publiées, le découpage territorial écrit — sans aucun réglage (par la livraison, aucun
# compte requis). Facultatif : adresse d'un compte GeoData (rôles « gestionnaire-donnees » et « responsable-publication »,
# aucun mot de passe) au nom duquel le faire. Quittance : GET /version/donnees.
# PREPROD_GEODATA_IMPORT_AUTO_PAR=

# Sources provisoires GeoData (D-GD-54, ex. prix des quartiers repris de FeenWay pour le développement) : admises par
# défaut en préproduction (oui) ; « non » les coupe (elles ne sont alors ni importées, ni archivées, ni servies).
# PREPROD_GEODATA_SOURCES_PROVISOIRES=oui
