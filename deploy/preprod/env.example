# Préproduction Fadi — clés attendues (valeurs générées par `fadi-preprod init-env`, jamais commitées, jamais celles de la production).
PREPROD_POSTGRES_PASSWORD=
PREPROD_ARCHIVE_SIGNING_KEY=
# Phase 3 (hôte seulement) : http://localhost:3001 — phase 4 (sur accord) : https://preprod.fadimmo.com
PREPROD_WEB_ORIGIN=http://localhost:3001
PREPROD_AUTH_RATE_LIMIT=500
PREPROD_API_RATE_LIMIT=5000
# Gestion des comptes (D-7) : mot de passe du rôle fadi_app (l'application ne se connecte jamais en superutilisateur) et
# clé de chiffrement des secrets de double authentification (32 octets en base64). Ajoutées par `fadi-preprod init-env`
# à un fichier existant, sans rien modifier d'autre.
PREPROD_FADI_APP_DB_PASSWORD=
PREPROD_FADI_ENCRYPTION_KEY=
# Administration de la plateforme (désactivée par défaut). Aucun transport de courriel : liens à copier affichés.
# PREPROD_FADI_ADMIN_ENABLED=false
