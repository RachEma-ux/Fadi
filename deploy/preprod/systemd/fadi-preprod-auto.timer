# Fadi — passage de fadi-preprod-auto toutes les 5 minutes (un seul à la fois : service oneshot + verrou du script).
[Unit]
Description=Fadi — préproduction automatique toutes les 5 minutes

[Timer]
OnCalendar=*:0/5
RandomizedDelaySec=30
Persistent=false
Unit=fadi-preprod-auto.service

[Install]
WantedBy=timers.target
