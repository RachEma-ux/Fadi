# All static FadiFront resources are served by the authenticated PHP front controller.
Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^index\.php$ - [L]
RewriteRule ^(?:\.htaccess|front\.html|index\.html)$ - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+)$ index.php?asset=$1 [B,L,QSA]
RewriteRule ^ index.php [L]
