{
  "id": "site",
  "nom": { "fr": "Site et terrain", "en": "Site and terrain" },
  "description": {
    "fr": "Terrain triangulé depuis des points cotés, courbes de niveau DXF posées à leur cote, unité foncière, pleine terre et coefficient de biotope, volumes du contexte à leur hauteur ; rien de fourni par défaut.",
    "en": "Terrain triangulated from spot heights, DXF contour lines laid at their elevation, land unit, open ground and biotope factor, context volumes at their height; nothing provided by default."
  },
  "version": "1.0.0",
  "auteur": "Fadi",
  "protocole": "1.1",
  "permissions": ["modele.lire", "modele.modifier", "selection", "messages", "panneau", "evenements", "donnees", "fichiers"],
  "commandes": [
    { "id": "ouvrir-panneau", "libelle": { "fr": "Site et terrain", "en": "Site and terrain" }, "icone": "ouvrir.svg", "raccourci": "Ctrl+Alt+G" },
    { "id": "terrain", "libelle": { "fr": "Terrain depuis des points", "en": "Terrain from points" }, "icone": "terrain.svg", "raccourci": "Ctrl+Maj+F10" },
    { "id": "courbes", "libelle": { "fr": "Courbes de niveau", "en": "Contour lines" }, "icone": "courbes.svg", "raccourci": "Ctrl+Maj+F3" },
    { "id": "unite-fonciere", "libelle": { "fr": "Unité foncière", "en": "Land unit" }, "icone": "unite.svg", "raccourci": "Ctrl+Maj+F4" },
    { "id": "biotope", "libelle": { "fr": "Pleine terre et biotope", "en": "Open ground and biotope" }, "icone": "biotope.svg", "raccourci": "Ctrl+Maj+F5" },
    { "id": "volumes", "libelle": { "fr": "Volumes du contexte", "en": "Context volumes" }, "icone": "volumes.svg", "raccourci": "Ctrl+Maj+F6" }
  ],
  "outils": [],
  "panneaux": [
    { "id": "site", "titre": { "fr": "Site et terrain", "en": "Site and terrain" }, "page": "panneau.html", "icone": "panneau.svg" }
  ],
  "abonnements": ["modele.change", "selection.change"]
}
