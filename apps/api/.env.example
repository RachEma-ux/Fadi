# Copy this file to .env (never commit .env itself — it is in .gitignore).

# Local dev database (created once with: see apps/api/README.md).
DATABASE_URL=postgresql://fadi:fadi_dev_password@localhost:5432/fadi

# Comma-separated list of origins allowed to call this API with credentials.
WEB_ORIGIN=http://localhost:5173

# Port the API listens on.
PORT=3001

# Set to "production" to enable secure, HTTPS-only session cookies.
NODE_ENV=development

# Rate limits per minute and per IP (defaults: 20 on /auth, 300 elsewhere).
# Only loosen them for test suites or a scenario runner — never in production.
# AUTH_RATE_LIMIT=20
# API_RATE_LIMIT=300

# Time zone used to print an editing-reservation deadline in server messages (default Europe/Paris).
# FADI_TZ=Europe/Paris
