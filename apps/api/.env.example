# Copy this file to .env (never commit .env itself — it is in .gitignore).

# Local dev database (created once with: see apps/api/README.md).
DATABASE_URL=postgresql://fadi:fadi_dev_password@localhost:5432/fadi

# Comma-separated list of origins allowed to call this API with credentials.
WEB_ORIGIN=http://localhost:5173

# Port the API listens on.
PORT=3001

# Set to "production" to enable secure, HTTPS-only session cookies.
NODE_ENV=development

# Rate limits per minute and per IP (defaults: 20 on /auth, 300 elsewhere).
# Only loosen them for test suites or a scenario runner — never in production.
# AUTH_RATE_LIMIT=20
# API_RATE_LIMIT=300

# Time zone used to print an editing-reservation deadline in server messages (default Europe/Paris).
# FADI_TZ=Europe/Paris

# --- D-7 : rôles PostgreSQL au moindre privilège (docs/workstreams/users-management/AMENDEMENT-D7.md) ---
# DATABASE_URL désigne le rôle applicatif fadi_app (aucun droit DDL). Valeurs factices : mots de passe hors dépôt.
# DATABASE_URL=postgresql://fadi_app:change-me@localhost:5432/fadi
# Migration (npm run db:migrate, MIGRATE_ON_START) avec fadi_migrator, membre de fadi_owner :
# DATABASE_MIGRATION_URL=postgresql://fadi_migrator:change-me@localhost:5432/fadi
# Tâche de rétention du journal d'audit (anonymisation de colonnes seulement) :
# DATABASE_RETENTION_URL=postgresql://fadi_retention:change-me@localhost:5432/fadi
# Retour arrière seulement : accepter un rôle avec droits DDL en production (avertissement au démarrage).
# ALLOW_PRIVILEGED_DB_ROLE=1

# --- Gestion des comptes (docs/workstreams/users-management) ---
# Administration /admin : désactivée tant que ce drapeau n'est pas "true".
# FADI_ADMIN_ENABLED=false
# Clé de chiffrement des secrets TOTP : 32 octets en base64 (openssl rand -base64 32), jamais dans le dépôt.
# FADI_ENCRYPTION_KEY=
# Courriel (D-1) : smtp | console (interdit en production) ; absent = aucun envoi, liens à copier affichés.
MAIL_TRANSPORT=smtp
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
# SSL/TLS implicite
SMTP_SECURE=true
# Adresse complète ; MAIL_FROM doit porter la même adresse (exigence Infomaniak).
SMTP_USER=noreply@exemple.ch
SMTP_PASS=change-me
MAIL_FROM="Fadi <noreply@exemple.ch>"
# Garde-fou Fadi, sous le quota du fournisseur (200 à 500 / 24 h selon l'offre) ; 5 courriels / heure / destinataire.
MAIL_DAILY_LIMIT=150
# MAIL_RECIPIENT_HOURLY_LIMIT=5
# Base des liens envoyés par courriel.
APP_PUBLIC_URL=https://fadi.exemple.ch
