{
  "name": "@fadi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db-guard": "vitest run --config vitest.guard.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:volumes-gc": "tsx src/db/volumes-gc.ts",
    "db:account-jobs": "tsx src/db/account-jobs.ts",
    "geodata:import-reference": "tsx src/db/geodata-reference.ts",
    "geodata:import-decoupage": "tsx src/db/geodata-reference.ts --decoupage",
    "geodata:role": "tsx src/db/geodata-role.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "~2.0.2",
    "@parcours/atelier-model": "0.1.0",
    "@parcours/core-geometry": "0.1.0",
    "@parcours/domain-model": "0.1.0",
    "@parcours/geodata-model": "0.1.0",
    "@parcours/geometry-exact": "0.1.0",
    "@parcours/planche-model": "0.1.0",
    "@parcours/sandbox-planche-model": "0.1.0",
    "cookie": "~1.0.2",
    "cors": "~2.8.5",
    "dotenv": "~17.2.3",
    "drizzle-orm": "~0.45.3",
    "express": "~5.1.0",
    "express-rate-limit": "~7.5.0",
    "geotiff": "3.0.5",
    "helmet": "~8.1.0",
    "nodemailer": "~7.0.6",
    "pg": "~8.16.3",
    "proj4": "~2.22.0",
    "qrcode": "~1.5.4",
    "web-ifc": "0.0.78",
    "ws": "8.22.0",
    "zod": "~4.1.12"
  },
  "devDependencies": {
    "@types/cors": "~2.8.19",
    "@types/express": "~5.0.3",
    "@types/node": "~22.15.2",
    "@types/nodemailer": "~7.0.1",
    "@types/pg": "~8.11.10",
    "@types/proj4": "~2.5.6",
    "@types/qrcode": "~1.5.5",
    "@types/supertest": "~6.0.2",
    "@types/ws": "8.18.1",
    "esbuild": "~0.25.12",
    "supertest": "~7.1.4",
    "tsx": "~4.19.2",
    "typescript": "~5.9.3",
    "vitest": "5.0.3"
  }
}
