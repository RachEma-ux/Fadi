{
  "name": "@fadi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-static-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@parcours/domain-model": "0.1.0",
    "@node-rs/argon2": "~2.0.2",
    "cookie": "~1.0.2",
    "cors": "~2.8.5",
    "drizzle-orm": "~0.45.3",
    "express": "~5.1.0",
    "express-rate-limit": "~7.5.0",
    "helmet": "~8.1.0",
    "pg": "~8.16.3",
    "zod": "~4.1.12"
  },
  "devDependencies": {
    "@types/cors": "~2.8.19",
    "@types/express": "~5.0.3",
    "@types/node": "~22.15.2",
    "@types/pg": "~8.11.10",
    "@types/supertest": "~6.0.2",
    "dotenv": "~17.2.3",
    "supertest": "~7.1.4",
    "tsx": "~4.19.2",
    "typescript": "~5.9.3",
    "vitest": "~3.2.4"
  }
}
