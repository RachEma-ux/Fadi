# DB-1/2: only `npm run test:db-guard` is executable, entirely simulated.
# Real DB trials are a separately authorized DB-3; production DATABASE_URL
# is never reused. Blank values intentionally fail closed.
TEST_DATABASE_URL=
TEST_DATABASE_RUN_ID=
TEST_DATABASE_COMMIT_SHA=
TEST_DATABASE_ATTESTATION_FILE=
# A descriptor is NOT a trust anchor. DB-3 (CI only): scripts/db3/preparer-base-test.mjs
# prepares the job's disposable PostGIS and signs with the enrolled "fadi-ci-db3" key
# (see src/testing/README.md); no local key is ever enrolled.

# app.test.ts registers a fresh user per authorization scenario within one
# shared Express app instance (one in-memory rate limiter for the whole
# file) — the production default (20 / 15 min) is too tight for that many
# scenarios. Test-only; production keeps the strict default. CI sets this
# directly too (see .github/workflows/ci.yml), not via this file.
AUTH_RATE_LIMIT=500
# Même raison pour la limite générale de l'API (300 / min en production).
API_RATE_LIMIT=5000
