# Swiss Backup Swift — variables de configuration Restic

# Exemple uniquement : ne jamais insérer d'identifiants ou de mots de passe réels dans GitHub.
# Installer sur le VPS dans /etc/fadi/restic.env (root:root 0600).
# Les chemins et la région sont issus du service Swift/Keystone v3 créé pour Fadi.
# Le numéro de cluster se vérifie dans le Manager Infomaniak.

OS_AUTH_URL=https://swiss-backup02.infomaniak.com/identity/v3
OS_REGION_NAME=RegionOne
OS_PROJECT_NAME=sb_project_SBI-REMPLACER
OS_USERNAME=SBI-REMPLACER
OS_PASSWORD="REMPLACER_PAR_LE_SECRET_SWIFT"
OS_USER_DOMAIN_NAME=default
OS_PROJECT_DOMAIN_NAME=default
RESTIC_REPOSITORY=swift:sb_project_SBI-REMPLACER:/fadi-backups
RESTIC_PASSWORD_FILE=/etc/fadi/restic-password

# RESTIC_PASSWORD_FILE contient une clé de chiffrement distincte du mot de passe Swift.
# Le dépôt Restic doit être initialisé une seule fois, volontairement, via restic init.
# Conserver plusieurs copies chiffrées de la clé hors du VPS.
